FROM python:3.12-slim-bookworm

# 1. Install system tools
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    ca-certificates \
    gcc \
    g++ \
    unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

# 1b. Trust the corporate CA so apt/curl work behind the
#     TLS-intercepting proxy. Without this, apt rejects the Microsoft repo
#     with "certificate issuer is unknown" and msodbcsql18 cannot be found.
#     NOTE: ca-bundle.crt is gitignored (not in the repo). Place it
#     in this app/ directory before building behind the proxy. On-cluster
#     builds (OpenShift BuildConfig) that have the CA pre-trusted do not need
#     this file; drop this COPY/RUN pair in that environment.
COPY ca-bundle.crt /usr/local/share/ca-certificates/ca-bundle.crt
RUN update-ca-certificates

# 2. Add the Microsoft repo and install the ODBC driver. apt now trusts the
#    proxy CA, so no -k workaround is needed for the repo metadata.
RUN curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -fsSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && apt-get clean

WORKDIR /app
COPY . .
RUN pip install --no-cache-dir -r requirements.txt

EXPOSE 5000
CMD ["python", "app.py"]
