    "list": [
      {
        "name": "Measurement",
        "label": "Measurement",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "query": "http_req_duration,http_req_waiting,http_req_blocked,http_req_connecting,http_req_tls_handshaking,http_req_sending,http_req_receiving,api_latency,iteration_duration,group_duration",
        "current": {
          "selected": true,
          "text": [
            "http_req_duration",
            "http_req_blocked"
          ],
          "value": [
            "http_req_duration",
            "http_req_blocked"
          ]
