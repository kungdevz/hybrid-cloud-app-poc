{
  "uid": "98ad9ddd-c01a-47f1-9612-f914862a4839",
  "title": "k6 Load Testing Results",
  "description": "k6 results from InfluxDB 1.8 (database k6). Rebuilt with React panels for Grafana 11+ (Angular graph/singlestat are no longer supported).",
  "tags": [
    "k6",
    "load-test"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
