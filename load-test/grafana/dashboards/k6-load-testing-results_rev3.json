  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Virtual Users",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-k6"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "vus",
          "query": "SELECT max(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(none)"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "vus_max",
          "query": "SELECT max(\"value\") FROM \"vus_max\" WHERE $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per Second",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-k6"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "req/s",
          "query": "SELECT sum(\"value\") / ($__interval_ms / 1000) FROM \"http_reqs\" WHERE $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per Second",
      "description": "http_req_failed = failed HTTP requests; errors = failed check groups from load_test.js (custom Rate metric).",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-k6"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "failed requests/s",
          "query": "SELECT sum(\"value\") / ($__interval_ms / 1000) FROM \"http_req_failed\" WHERE $timeFilter GROUP BY time($__interval) fill(0)"
        },
        {
          "refId": "B",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "check errors/s",
          "query": "SELECT sum(\"value\") / ($__interval_ms / 1000) FROM \"errors\" WHERE $timeFilter GROUP BY time($__interval) fill(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Checks per Second",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-k6"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col",
          "query": "SELECT sum(\"value\") / ($__interval_ms / 1000) AS \"passed\", (count(\"value\") - sum(\"value\")) / ($__interval_ms / 1000) AS \"failed\" FROM \"checks\" WHERE $timeFilter GROUP BY time($__interval) fill(none)"
        }
      ]
    },
